rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidBadge(badge) {
      return badge.keys().hasAll(['badgeId', 'fullNameAmharic', 'fullNameEnglish']) &&
        badge.badgeId is string && badge.badgeId.size() > 0 &&
        badge.fullNameAmharic is string && badge.fullNameAmharic.size() > 0;
    }

    // Police Badges collection
    match /badges/{badgeId} {
      // Public verification: Anyone can read badges to verify officer identity via QR code or ID lookup
      allow read: if true;

      // Create and Update: Anyone can register or update badge details in Firestore
      allow create, update: if true;

      // Delete: Anyone or authenticated users can manage badges
      allow delete: if true;
    }
  }
}
